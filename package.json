{
  "name": "@johnhenry/mport",
  "version": "0.0.1",
  "description": "Route JavaScript imports across any number of CDNs: deterministic resolution, adaptive transport (fallback, race, weighted, health-aware), compiled to standard import maps.",
  "homepage": "https://opensource.johnhenry.me/mport/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/mport.git"
  },
  "bugs": {
    "url": "https://github.com/johnhenry/mport/issues"
  },
  "author": "John Henry <john@iamjohnhenry.com>",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "main": "./src/index.mjs",
  "module": "./src/index.mjs",
  "types": "./src/types.d.ts",
  "exports": {
    ".": {
      "types": "./src/types.d.ts",
      "default": "./src/index.mjs"
    },
    "./firefox": {
      "types": "./src/types.d.ts",
      "default": "./src/firefox.mjs"
    },
    "./core": {
      "types": "./src/core.d.ts",
      "default": "./src/core.mjs"
    },
    "./node": {
      "types": "./src/node.d.ts",
      "default": "./src/node.mjs"
    },
    "./vite": {
      "types": "./src/vite.d.ts",
      "default": "./src/vite.mjs"
    },
    "./rollup": {
      "types": "./src/rollup.d.ts",
      "default": "./src/rollup.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "mport": "bin/mport.mjs"
  },
  "files": [
    "src",
    "bin",
    "docs",
    "CHANGELOG.md",
    "README.md",
    "LICENSE.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "import",
    "esm",
    "import-map",
    "importmap",
    "npm",
    "jsr",
    "cdn",
    "jsdelivr",
    "esm.sh",
    "jspm",
    "unpkg",
    "router",
    "fallback",
    "race",
    "dynamic-import"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "test:browser": "playwright test",
    "typecheck": "tsc -p tsconfig.json",
    "examples": "for f in examples/[0-9]*.mjs; do node \"$f\" || exit 1; done",
    "bench": "node bench/bench.mjs",
    "example:01": "node examples/01-ranges-resolve-once-to-exact-versions.mjs",
    "example:02": "node examples/02-fallback-skips-a-cdn-that-is-down.mjs",
    "example:03": "node examples/03-race-first-success-wins-losers-are-not-blamed.mjs",
    "example:04": "node examples/04-commonjs-is-skipped-on-raw-cdns.mjs",
    "example:05": "node examples/05-lockfile-pins-version-and-build.mjs",
    "example:06": "node examples/06-circuit-breaker-opens-and-resets.mjs",
    "example:07": "node examples/07-verified-rejects-a-tampered-mirror.mjs",
    "example:08": "node examples/08-router-import-fails-over-at-runtime.mjs",
    "example:09": "node examples/09-build-compiles-an-import-map-and-lockfile.mjs",
    "example:10": "node examples/10-cli-builds-offline-from-a-config.mjs",
    "example:11": "node examples/11-v1-api-races-origins-on-the-router.mjs",
    "example:12": "node examples/12-server-renders-an-import-map-with-preloads.mjs",
    "example:13": "node examples/13-conflicting-versions-get-scopes.mjs",
    "example:14": "node examples/14-whole-graph-integrity-in-the-lockfile.mjs",
    "example:15": "node examples/15-outdated-and-update-keep-the-lockfile-current.mjs",
    "example:16": "node examples/16-rollup-plugin-routes-bare-imports.mjs",
    "example:17": "node examples/17-local-serves-a-package-that-is-not-on-npm.mjs",
    "example:18": "node examples/18-csp-hash-for-a-static-sites-import-map.mjs",
    "example:19": "node examples/19-dependencies-of-a-raw-cdn-package-join-the-map.mjs",
    "example:20": "node examples/20-app-owned-prefix-needs-no-registry.mjs",
    "example:21": "node examples/21-integrity-manifest-for-an-html-modules-graph.mjs",
    "demo": "deno -A examples/demo.mjs",
    "demo:firefox": "deno -A examples/demo.firefox.mjs",
    "demo:html": "python3 -m http.server 8712",
    "size": "node scripts/size.mjs",
    "jsr-dry-run": "npx --yes jsr@0.14.3 publish --dry-run --allow-dirty"
  },
  "devDependencies": {
    "@johnhenry/html-modules": "git+https://github.com/johnhenry/html-modules.git#4558a7a735d34fa5ce9f5540fcdfccb6a2125056",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.0",
    "htm": "^3.1.1",
    "preact": "^10.29.8",
    "rollup": "^4.63.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "peerDependencies": {
    "@johnhenry/html-modules": "*"
  },
  "peerDependenciesMeta": {
    "@johnhenry/html-modules": {
      "optional": true
    }
  },
  "sizeBudget": {
    "tarball": 125000,
    "unpacked": 380000,
    "entries": {
      ".": 36000,
      "./firefox": 36000,
      "./core": 36000,
      "./node": 7000,
      "./vite": 11800,
      "./rollup": 11400
    }
  }
}
